# ==============================================================================
# Variables de Entorno - Centro Educativo "Transformar para educar" (App Móvil)
# ==============================================================================
# NOTA: En Expo SDK 49+, las variables con prefijo EXPO_PUBLIC_ están disponibles
# en el cliente móvil en tiempo de compilación/ejecución (process.env.EXPO_PUBLIC_*).
#
# Copiar este archivo a .env y ajustar según el entorno de ejecución:
#   - Emulador Android oficial: http://10.0.2.2:8000/api
#   - Dispositivo físico vía Expo Go: http://<TU_IP_LOCAL>:8000/api (ej. http://192.168.1.15:8000/api)
#   - Producción / Staging: https://educarparatransformar.pythonanywhere.com/api
# ==============================================================================

# URL Base del backend Django (Django REST Framework)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Timeout en milisegundos para peticiones HTTP con Axios (RNF_M05)
EXPO_PUBLIC_API_TIMEOUT=10000

# Nombre de la aplicación e información institucional
EXPO_PUBLIC_APP_NAME="Educar para Transformar"
EXPO_PUBLIC_INSTITUTION_NAME="Centro Educativo Transformar para educar"

# Configuración para pruebas de contratos y E2E (Playwright)
TEST_API_URL=http://127.0.0.1:8000/api
TEST_USER_TUTOR=tutor_demo
TEST_PASS_TUTOR=password123
TEST_USER_ADMIN=admin_demo
TEST_PASS_ADMIN=admin123
